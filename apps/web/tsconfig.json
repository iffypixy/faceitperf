{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
